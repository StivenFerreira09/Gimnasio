        <mxCell id="6F2bThe8U24z-9CD6q8i-197" parent="1" style="ellipse;whiteSpace=wrap;html=1;align=center;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" value="atributo" vertex="1">
