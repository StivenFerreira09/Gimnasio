        <mxCell id="Md8-PlI_Wf8loc9Fz64_-225" parent="Md8-PlI_Wf8loc9Fz64_-222" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;overflow=hidden;rotatable=0;whiteSpace=nowrap;fontSize=11;fontFamily=Helvetica;" value="+ estaVencido(): boolean&lt;br&gt;+ registrarIntentoFallido(): void&lt;br&gt;+ getters()" vertex="1">
